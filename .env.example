# =============================================================================
# StartWithA — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Docker Compose overrides DATABASE_URL and REDIS_URL automatically,
# so you only need to set them here if you're running without Docker.
# =============================================================================

# -----------------------------------------------------------------------------
# Flask
# -----------------------------------------------------------------------------
SECRET_KEY='change-me-to-a-random-string'
FLASK_APP='run.py'
FLASK_DEBUG='False'

# -----------------------------------------------------------------------------
# Auth0  (required for production; optional if DEMO_MODE is enabled)
# -----------------------------------------------------------------------------
# 1. Create a free Auth0 tenant at https://auth0.com
# 2. Create a "Regular Web Application"
# 3. Set the Allowed Callback URL to:
#      http://localhost:8000/auth/callback   (Docker)
#      http://localhost:5000/auth/callback   (local flask run)
# 4. Copy the credentials below from Settings
AUTH0_DOMAIN='your-tenant.auth0.com'
AUTH0_CLIENT_ID='your-client-id'
AUTH0_CLIENT_SECRET='your-client-secret'
AUTH0_CALLBACK_URL='http://localhost:8000/auth/callback'
AUTH0_AUDIENCE='https://your-tenant.auth0.com/userinfo'

# Comma-separated emails that get admin access at /admin
ADMIN_EMAILS='you@example.com'

# -----------------------------------------------------------------------------
# AI API Keys  (at least one required for AI features)
# -----------------------------------------------------------------------------
# Gemini is the default provider and also powers embeddings (pgvector search,
# Argos similarity), so this one key is enough to run everything.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY='your-gemini-api-key'

# Optional additional text-generation providers. Setting a key makes that
# provider's models selectable per prompt category in Settings → AI Models.
# ANTHROPIC_API_KEY='your-anthropic-api-key'
# DEEPSEEK_API_KEY='your-deepseek-api-key'

# NOTE: there is no OpenAI *text generation* provider — app/services/ai/providers/
# ships gemini, claude and deepseek only. OPENAI_API_KEY is used for EMBEDDINGS
# only, as are the two below. Gemini embeddings are the default; without any of
# these, embeddings fall back to TF-IDF.
# OPENAI_API_KEY='your-openai-api-key'
# VOYAGE_API_KEY='your-voyage-api-key'
# COHERE_API_KEY='your-cohere-api-key'

# Model routing (all optional — see app/services/ai/config.py for valid ids)
# AI_DEFAULT_MODEL='gemini-3-flash-preview'
# AI_QUALITY_MODEL='gemini-2.5-pro'
# AI_FAST_MODEL='gemini-3-flash-preview'
# AI_PREFER_CLAUDE='true'    # route reasoning tasks to Claude when a key is set

# -----------------------------------------------------------------------------
# Database & Redis  (set automatically by Docker Compose)
# -----------------------------------------------------------------------------
# Only set these if running WITHOUT Docker:
# DATABASE_URL='postgresql://postgres:postgres@localhost:5432/investment_checklist'
# REDIS_URL='redis://redis:6379/0'

# -----------------------------------------------------------------------------
# Frontend analytics  (OFF by default — leave unset for no tracking at all)
# -----------------------------------------------------------------------------
# Set ANALYTICS_PROVIDER + ANALYTICS_SITE_ID to enable. The provider's origins
# are added to the Content-Security-Policy automatically; nothing else to edit.
# Supported: clarity | plausible | umami | posthog  (see app/telemetry.py)
#
#   clarity   → site id from https://clarity.microsoft.com (project id)
#   plausible → your site domain, e.g. 'app.example.com'
#   umami     → website id (UUID)
#   posthog   → project API key
#
# ANALYTICS_PROVIDER='clarity'
# ANALYTICS_SITE_ID='your-clarity-project-id'

# Self-hosted Plausible/Umami: point at your own script; its origin is added
# to the CSP for you.
# ANALYTICS_SCRIPT_URL='https://analytics.example.com/script.js'

# Clarity and PostHog set cookies and record sessions, so they are held behind
# an Accept/Decline banner (TDDDG § 25(1) / GDPR Art. 6(1)(a)) and the tag is
# not loaded until the user accepts. Only disable this if you have another
# lawful basis. Cookieless providers ignore it and load immediately.
# ANALYTICS_REQUIRE_CONSENT='True'

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# DEMO_MODE='true'                        # Seed a demo user for trying the app
# NEWS_API_KEY='your-newsapi-key'        # NewsAPI for market news
# DEFAULT_USER_TIER='amateur'             # Default tier for new users (amateur|pro)
# FEATURE_GATING_ENABLED='False'         # True restores progressive unlocking.
#                                        # Default False: every user sees every
#                                        # feature from first login.
# SESSION_COOKIE_SECURE='False'          # Set True behind HTTPS
# UPLOAD_FOLDER='/app/instance/uploads'  # File upload path
